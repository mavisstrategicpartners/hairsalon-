# Biana HAIR — environment template
# Copy to .env.local and fill in real values. Do not commit .env.local.
# Only NEXT_PUBLIC_* values reach the browser; everything else is server-only.

# --- Supabase (Project Settings -> API) -------------------------------------

# Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SERVER ONLY. Bypasses Row Level Security.
# Never prefix this with NEXT_PUBLIC_ and never import it into a client component.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Transactional email (Resend) -------------------------------------------
# SERVER ONLY. Without these, orders are still stored and the site still works;
# order emails are skipped and a warning is logged.

RESEND_API_KEY=your-resend-api-key
# Must be a verified sender on your Resend domain, e.g. "Biana HAIR <orders@yourdomain.co.za>"
RESEND_FROM=
# Where new-order notifications are sent. Leave blank to skip admin notifications.
ADMIN_ORDER_EMAIL=

# --- EFT banking details ----------------------------------------------------
# SERVER ONLY. All four account fields must be set before any are shown to a
# customer; if any is missing, no banking figures are displayed anywhere.

BANK_NAME=
BANK_ACCOUNT_NAME=
BANK_ACCOUNT_NUMBER=
BANK_BRANCH_CODE=
# Optional sentence shown with the details. Defaults to asking the customer to
# use their order number as the reference.
BANK_REFERENCE_INSTRUCTIONS=
